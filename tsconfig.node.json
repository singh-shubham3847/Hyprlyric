{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"] },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "tests-live/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.live.config.ts"
  ]
}
